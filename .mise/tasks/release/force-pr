#!/usr/bin/env bash
#MISE description="CI-only: open or update the release-please release PR for an exact version (release.yml manual run with a new tag)"
#USAGE arg "<version>" help="X.Y.Z, without the leading v"
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../../.."
: "${GH_TOKEN:?}" "${GITHUB_REPOSITORY:?}"

version=${usage_version:?}
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "version must be X.Y.Z, got '$version'" >&2; exit 1; }

# The release-please action ignores its release-as input when a manifest
# config is used; the CLI honours --release-as in manifest mode.
npx --yes release-please@17.11.2 release-pr \
  --token "$GH_TOKEN" \
  --repo-url "$GITHUB_REPOSITORY" \
  --target-branch main \
  --config-file release-please-config.json \
  --manifest-file .release-please-manifest.json \
  --release-as "$version"
