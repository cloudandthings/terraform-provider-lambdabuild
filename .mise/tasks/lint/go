#!/usr/bin/env bash
#MISE description="Check gofmt, then run go vet and golangci-lint"
#MISE depends=["uv:fetch"]
set -euo pipefail
unformatted="$(gofmt -l $(git ls-files '*.go'))"
if [ -n "$unformatted" ]; then
  echo "gofmt needed (run gofmt -w):" >&2
  echo "$unformatted" >&2
  exit 1
fi
go vet ./...
golangci-lint run ./...
