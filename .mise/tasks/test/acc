#!/usr/bin/env bash
#MISE description="Run Terraform acceptance tests (seam A) against the mise-pinned Terraform"
#MISE depends=["uv:fetch"]
set -euo pipefail
export TF_ACC=1
# mise which resolves the per-OS install dir and terraform.exe on Windows.
export TF_ACC_TERRAFORM_PATH="$(mise which terraform)"
go test ./internal/provider/... -count=1 "$@"
